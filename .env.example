# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI API key used for chat completions and embeddings (required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

