# Copy to infra/.env (gitignored); docker compose reads it automatically.

# Required for chat replies, embeddings and graph extraction. Without it the
# stack still starts, and chat answers with an "AI unavailable" fallback.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Token lifetime in minutes.
JWT_EXPIRY_MINUTES=1440

# Frontend origins allowed to call the gateway directly (comma-separated).
# Not needed in dev: Vite proxies /api to the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
